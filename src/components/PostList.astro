---
import type { Post } from '../lib/site';
import { estimateReadingTime, formatPostDate, postCoverUrl, postSlug } from '../lib/site';

interface Props {
  posts: Post[];
  numbered?: boolean;
}

const { posts, numbered = false } = Astro.props;
---

<div class="post-list">
  {posts.map((post, index) => {
    const cover = postCoverUrl(post);
    const slug = postSlug(post);
    return (
      <article class:list={['post-card', 'surface', { 'post-card--no-cover': !cover }]}>
        <div>
          <div class="meta-line">
            {numbered && <span>{String(index + 1).padStart(2, '0')}</span>}
            <time datetime={post.data.date}>{formatPostDate(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{estimateReadingTime(post.body || '')}</span>
          </div>
          <h2><a href={`/blog/${slug}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tags" style="margin-top: 1rem">
              {post.data.tags.map((tag) => <a class="tag" href={`/blog/tags/${tag}/`}>#{tag}</a>)}
            </div>
          )}
        </div>
        {cover && <a href={`/blog/${slug}/`} aria-label={post.data.title}><img src={cover} alt="" loading="lazy" decoding="async" /></a>}
      </article>
    );
  })}
</div>
