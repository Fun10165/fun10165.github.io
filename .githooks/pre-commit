#!/usr/bin/env bash
# pre-commit — type-check and build the Astro site when site inputs are staged
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo -e "${YELLOW}┌─ pre-commit Astro check ──────────────┐${NC}"

staged_site=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^(src/|content/|public/|scripts/|astro\.config\.mjs$|tsconfig\.json$|package(-lock)?\.json$|\.github/workflows/deploy\.yml$)' || true)

if [[ -z "$staged_site" ]]; then
  echo "│  No staged Astro site inputs to check │"
  echo -e "${YELLOW}└────────────────────────────────────────┘${NC}"
  echo ""
  exit 0
fi

if npm run check:blog; then
  echo -e "${YELLOW}└────────────────────────────────────────┘${NC}"
  echo -e "${GREEN}pre-commit: Astro checks passed ✓${NC}"
  echo ""
  exit 0
fi

echo -e "${YELLOW}└────────────────────────────────────────┘${NC}"
echo -e "${RED}pre-commit: Astro checks failed — commit blocked${NC}"
exit 1

