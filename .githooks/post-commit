#!/usr/bin/env bash
# post-commit — run full Astro validation after a commit is created
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo -e "${YELLOW}┌─ post-commit Astro check ─────────────┐${NC}"
npm run check:blog
echo -e "${YELLOW}└────────────────────────────────────────┘${NC}"
echo -e "${GREEN}post-commit: Astro checks passed ✓${NC}"
echo ""
